---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Heredita — Store" active="store">
  <main class="container" style="padding-top: 22px;">
    <div class="section-title reveal">
      <h1 class="tilt-l">Store <span class="muted" style="font-family:'Architects Daughter',cursive; font-size:1rem;">/ Marketplace</span> <span class="lock-pill" title="Coming soon — preview only">🔒 Coming Soon</span></h1>
      <span class="muted">browse — buying enabled with the paid release</span>
    </div>

    <div class="store-featured">
      <article class="chalk-card featured-card reveal delay-1">
        <span class="badge">Coming soon</span>
        <h3>Countryball Avatar Pack</h3>
        <p class="muted" style="margin:0;">30 modern nations + 12 alt-history flags, hats, eyewear, props. <a href="/avatar">Customize yours →</a></p>
        <div class="row" style="margin-top:auto;">
          <span class="price-pill"><span class="coin"></span> 0 — TBA</span>
          <span class="lock-badge">Locked</span>
        </div>
        <svg class="glyph" viewBox="0 0 200 200" aria-hidden="true">
          <circle cx="100" cy="100" r="80" fill="#fff" stroke="#000" stroke-width="3"/>
          <rect x="50" y="80" width="100" height="40" fill="#d97a3d"/>
          <circle cx="100" cy="100" r="80" fill="none" stroke="#000" stroke-width="3"/>
        </svg>
      </article>

      <article class="chalk-card featured-card reveal delay-2">
        <span class="badge">Coming soon</span>
        <h3>Title Banner — Cartographer</h3>
        <p class="muted" style="margin:0;">A rare "Cartographer" banner with gold chalk flourish. Slots above your username in lobbies.</p>
        <div class="row" style="margin-top:auto;">
          <span class="price-pill"><span class="coin"></span> 0 — TBA</span>
          <span class="lock-badge">Locked</span>
        </div>
        <svg class="glyph" viewBox="0 0 200 200" aria-hidden="true">
          <rect x="20" y="80" width="160" height="40" fill="#7d1c1c" stroke="#000" stroke-width="3"/>
          <polygon points="20,120 40,100 20,80" fill="#5a1010"/>
          <polygon points="180,120 160,100 180,80" fill="#5a1010"/>
          <text x="100" y="108" text-anchor="middle" font-family="Caveat" font-size="22" fill="#FFD700">CARTO</text>
        </svg>
      </article>

      <article class="chalk-card featured-card reveal delay-3">
        <span class="badge">Coming soon</span>
        <h3>Brush Bundle — Calligraphy</h3>
        <p class="muted" style="margin:0;">10 new brushes for borders, hatching, and ornamental flourishes.</p>
        <div class="row" style="margin-top:auto;">
          <span class="price-pill"><span class="coin"></span> 0 — TBA</span>
          <span class="lock-badge">Locked</span>
        </div>
        <svg class="glyph" viewBox="0 0 200 200" aria-hidden="true">
          <rect x="40" y="140" width="120" height="20" rx="4" fill="#5a3a14"/>
          <polygon points="40,140 30,170 60,160" fill="#1a1a1a"/>
          <path d="M70,40 q40,30 80,0 q-30,60 -80,0" fill="none" stroke="#d97a3d" stroke-width="3"/>
        </svg>
      </article>
    </div>

    <div class="section-title reveal" style="margin-top:36px;">
      <h2 class="tilt-r">Avatar Items</h2>
      <span class="muted">customize your countryball</span>
    </div>
    <div class="store-grid">
      <article class="chalk-card store-item reveal">
        <div class="thumb">
          <svg viewBox="0 0 200 200" aria-hidden="true">
            <circle cx="100" cy="100" r="80" fill="#fff" stroke="#000" stroke-width="3"/>
            <rect x="20" y="80" width="160" height="20" fill="#dc143c"/>
          </svg>
        </div>
        <h3>Countryballs Pack</h3>
        <p>30 modern nations + 12 historical empires.</p>
        <div class="row-bottom">
          <span class="lock-badge">Coming Soon</span>
          <span class="price-pill"><span class="coin"></span> 0</span>
        </div>
      </article>

      <article class="chalk-card store-item reveal">
        <div class="thumb">
          <svg viewBox="0 0 200 200" aria-hidden="true">
            <rect x="40" y="60" width="120" height="40" fill="#1a1a1a" stroke="#000" stroke-width="3"/>
            <rect x="20" y="100" width="160" height="14" fill="#1a1a1a" stroke="#000" stroke-width="3"/>
            <rect x="40" y="92"  width="120" height="8" fill="#d97a3d"/>
          </svg>
        </div>
        <h3>Hats Pack</h3>
        <p>Top hat, crown, beret, helmet, ushanka.</p>
        <div class="row-bottom">
          <span class="lock-badge">Coming Soon</span>
          <span class="price-pill"><span class="coin"></span> 0</span>
        </div>
      </article>

      <article class="chalk-card store-item reveal">
        <div class="thumb">
          <svg viewBox="0 0 200 200" aria-hidden="true">
            <circle cx="70" cy="100" r="26" fill="none" stroke="#FFD700" stroke-width="4"/>
            <circle cx="130" cy="100" r="26" fill="none" stroke="#FFD700" stroke-width="4"/>
            <line x1="96" y1="100" x2="104" y2="100" stroke="#FFD700" stroke-width="4"/>
          </svg>
        </div>
        <h3>Eyewear</h3>
        <p>Monocles, sunglasses, eye patches.</p>
        <div class="row-bottom">
          <span class="lock-badge">Coming Soon</span>
          <span class="price-pill"><span class="coin"></span> 0</span>
        </div>
      </article>

      <article class="chalk-card store-item reveal">
        <div class="thumb">
          <svg viewBox="0 0 200 200" aria-hidden="true">
            <rect x="30" y="60" width="140" height="80" fill="#7d1c1c" stroke="#000" stroke-width="3"/>
            <polygon points="30,140 50,120 30,100" fill="#5a1010"/>
            <polygon points="170,140 150,120 170,100" fill="#5a1010"/>
          </svg>
        </div>
        <h3>Banners</h3>
        <p>Profile banners with chalk flourishes.</p>
        <div class="row-bottom">
          <span class="lock-badge">Coming Soon</span>
          <span class="price-pill"><span class="coin"></span> 0</span>
        </div>
      </article>

      <article class="chalk-card store-item reveal">
        <div class="thumb">
          <svg viewBox="0 0 200 200" aria-hidden="true">
            <rect x="30" y="30" width="140" height="140" rx="8" fill="none" stroke="#d97a3d" stroke-width="6" stroke-dasharray="8 4"/>
            <rect x="50" y="50" width="100" height="100" rx="4" fill="none" stroke="#f4f1e6" stroke-width="2"/>
          </svg>
        </div>
        <h3>Frames</h3>
        <p>Decorative frames around your avatar.</p>
        <div class="row-bottom">
          <span class="lock-badge">Coming Soon</span>
          <span class="price-pill"><span class="coin"></span> 0</span>
        </div>
      </article>

      <article class="chalk-card store-item reveal">
        <div class="thumb">
          <svg viewBox="0 0 200 200" aria-hidden="true">
            <path d="M40,60 q60,-30 120,0 v60 q-60,30 -120,0 z" fill="#f4f1e6" stroke="#000" stroke-width="3"/>
            <path d="M60,170 l-10,20 l30,-15 z" fill="#f4f1e6" stroke="#000" stroke-width="3"/>
            <text x="100" y="105" text-anchor="middle" font-family="Caveat" font-size="34" fill="#1a1a1a">!</text>
          </svg>
        </div>
        <h3>Emotes</h3>
        <p>Reactions for in-game chat &amp; lobbies.</p>
        <div class="row-bottom">
          <span class="lock-badge">Coming Soon</span>
          <span class="price-pill"><span class="coin"></span> 0</span>
        </div>
      </article>
    </div>

    <div class="section-title reveal" style="margin-top:36px;">
      <h2 class="tilt-r">Brushes &amp; Dice</h2>
      <span class="muted">tools of the trade</span>
    </div>
    <div class="store-grid">
      <article class="chalk-card store-item reveal">
        <div class="thumb">
          <svg viewBox="0 0 200 200" aria-hidden="true">
            <rect x="40" y="140" width="120" height="20" rx="4" fill="#5a3a14"/>
            <polygon points="40,140 30,170 60,160" fill="#1a1a1a"/>
            <path d="M70,40 q40,30 80,0 q-30,60 -80,0" fill="none" stroke="#d97a3d" stroke-width="3"/>
          </svg>
        </div>
        <h3>Calligraphy Brushes</h3>
        <p>10 brushes for borders &amp; flourishes.</p>
        <div class="row-bottom">
          <span class="lock-badge">Coming Soon</span>
          <span class="price-pill"><span class="coin"></span> 0</span>
        </div>
      </article>

      <article class="chalk-card store-item reveal">
        <div class="thumb">
          <svg viewBox="0 0 200 200" aria-hidden="true">
            <rect x="50" y="50" width="100" height="100" rx="14" fill="#fff" stroke="#000" stroke-width="3" transform="rotate(-8 100 100)"/>
            <circle cx="80" cy="80" r="5" fill="#000" transform="rotate(-8 100 100)"/>
            <circle cx="120" cy="120" r="5" fill="#000" transform="rotate(-8 100 100)"/>
            <circle cx="80" cy="120" r="5" fill="#000" transform="rotate(-8 100 100)"/>
            <circle cx="120" cy="80" r="5" fill="#000" transform="rotate(-8 100 100)"/>
            <circle cx="100" cy="100" r="5" fill="#000" transform="rotate(-8 100 100)"/>
          </svg>
        </div>
        <h3>Bone Dice</h3>
        <p>Classic ivory-look D6s.</p>
        <div class="row-bottom">
          <span class="lock-badge">Coming Soon</span>
          <span class="price-pill"><span class="coin"></span> 0</span>
        </div>
      </article>

      <article class="chalk-card store-item reveal">
        <div class="thumb">
          <svg viewBox="0 0 200 200" aria-hidden="true">
            <polygon points="100,30 170,80 140,170 60,170 30,80" fill="#d97a3d" stroke="#000" stroke-width="3"/>
            <text x="100" y="125" text-anchor="middle" font-family="Caveat" font-size="50" font-weight="700" fill="#fff">20</text>
          </svg>
        </div>
        <h3>D20 Set — Imperial</h3>
        <p>For when D6 isn't dramatic enough.</p>
        <div class="row-bottom">
          <span class="lock-badge">Coming Soon</span>
          <span class="price-pill"><span class="coin"></span> 0</span>
        </div>
      </article>

      <article class="chalk-card store-item reveal">
        <div class="thumb">
          <svg viewBox="0 0 200 200" aria-hidden="true">
            <rect x="30" y="80" width="140" height="40" fill="#7d1c1c" stroke="#000" stroke-width="3"/>
            <text x="100" y="108" text-anchor="middle" font-family="Caveat" font-size="22" fill="#FFD700">TITLE</text>
          </svg>
        </div>
        <h3>Title Banners</h3>
        <p>Show off "Emperor", "Cartographer", more.</p>
        <div class="row-bottom">
          <span class="lock-badge">Coming Soon</span>
          <span class="price-pill"><span class="coin"></span> 0</span>
        </div>
      </article>
    </div>

    <p class="muted text-center reveal" style="margin: 30px 0 8px;">
      Store opens with the first paid release. <a href="/membership">Membership tiers</a> get bonus coins at launch.
    </p>
  </main>
</BaseLayout>
