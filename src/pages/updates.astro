---
import BaseLayout from '../layouts/BaseLayout.astro';
import UpdatesFeed from '../components/UpdatesFeed.tsx';
---

<BaseLayout title="Heredita — Updates">
  <main class="container">
    <div class="section-title reveal" style="margin-top:24px;">
      <h1 class="tilt-l">Patch notes</h1>
      <span class="muted">Newest first</span>
    </div>

    <div id="updatesTimeline" class="timeline" aria-live="polite">
      <UpdatesFeed client:load />
    </div>

    <p class="muted text-center" style="margin: 30px 0 10px;">
      Something you want on this list? Tell us in the support channel.
    </p>
  </main>
</BaseLayout>
