---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/HomePage.tsx';
---

<BaseLayout title="Heredita: Roleplay through history">
  <HomePage client:load />

  <div id="loadingOverlay" class="loading-overlay" role="status" aria-live="polite">
    <div class="spinner" aria-hidden="true"></div>
    <h2>Launching Heredita…</h2>
    <p id="loadingStatus" class="muted">Sharpening chalk…</p>
  </div>
</BaseLayout>
