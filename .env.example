# Heredita site — env vars for pointing the site at a debug/local game API.
#
# Copy this file to `.env` (gitignored) and adjust values as needed. Astro only
# exposes PUBLIC_* vars to client-side code, which is what the API client uses.
# No .env means the site uses production (https://app.heredita.net).

# Base URL of the game API used for auth + friends + search + the /updates
# patch-notes endpoint.
# For a local debug server, e.g.:
#   PUBLIC_HEREDITA_API=http://localhost:9000
PUBLIC_HEREDITA_API=https://app.heredita.net

# URL the PLAY / Continue buttons should open. Usually <API>/app/.
#   PUBLIC_HEREDITA_PLAY_URL=http://localhost:9000/app/
PUBLIC_HEREDITA_PLAY_URL=https://app.heredita.net/app/

# Extra browser origins allowed past the CORS gate, comma-separated.
# Useful for preview deploys: `https://my-preview.example.vercel.app`
# PUBLIC_HEREDITA_CORS_ORIGINS=https://preview.example.com

# Debug servers usually allow any origin. Set to "true" to skip the origin
# gate entirely so Friends / Search work locally without the heredita.net check.
PUBLIC_HEREDITA_ALLOW_ALL_CORS=false
